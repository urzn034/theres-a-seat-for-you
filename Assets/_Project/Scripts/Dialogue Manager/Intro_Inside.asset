  m_Script: {fileID: 11500000, guid: 2d0566c1c14859844878353d2cf97929, type: 3}
  m_Name: Intro_Inside
  m_EditorClassIdentifier: 
  lines:
  - speaker: Eve
    text: Uhhh... this place has a certain old-fashioned charm.
    textID: 
  - speaker: Eve
    text: "(...It\u2019s also filthy as hell.)"
    textID: 
  - speaker: Mr. Finch
    text: "Hahaha! Welcome to FINCH\u2019s, Eve!"
    textID: 
  - speaker: Mr. Finch
    text: "I tidied up a bit, but these old lungs aren\u2019t what they used to be.
      So I left some trash for you. Hope you don\u2019t mind!"
    textID: 
  - speaker: Eve
    text: Ah... right. Of course.
    textID: 
  - speaker: 'Mr. Finch '
    text: "Oh! There\u2019s a recipe book over there. Look at it whenever you need
      to, no need to memorize everything."
    textID: 
  - speaker: 'Mr. Finch '
    text: "And don\u2019t worry about getting overwhelmed. Business hasn\u2019t been
      great lately... we\u2019re a little short on customers."
    textID: 
  - speaker: Eve
    text: "Not many customers, huh? Well... I guess that\u2019s one good thing about
      this place....."
    textID: 
